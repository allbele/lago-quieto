{
  "name": "lago-quieto-steam",
  "productName": "Lago Quieto",
  "version": "1.0.0",
  "description": "Lago Quieto — clicker zen. Wrapper Electron para a build Steam.",
  "main": "main.js",
  "author": "Mateus",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --config electron-builder.yml",
    "build:win": "electron-builder --win --config electron-builder.yml",
    "build:linux": "electron-builder --linux --config electron-builder.yml",
    "build:all": "electron-builder --mac --win --linux --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  }
}
